# Project: omaGUI
# File: .gitattributes
# Purpose: Preserve the shared dependency's exact source and asset bytes.
# Responsibilities: Keep checkout hashes independent of parent EOL rules.
# This file contains no application-level Git policy.

# The manifests cover the stored bytes, including existing mixed line endings.
# Disabling text conversion here overrides the host repository's CRLF rules.
* -text

# end of .gitattributes
